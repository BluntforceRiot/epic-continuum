{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://epic-continuum.local/schemas/atomic_memory_card.schema.json",
  "title": "Epic Continuum Atomic Memory Card",
  "type": "object",
  "required": ["schema", "card_id", "card_type", "title", "summary", "status", "visibility_scope", "created_at", "updated_at"],
  "properties": {
    "schema": {"const": "continuum.atomic_memory.v2"},
    "card_id": {"type": "string", "pattern": "^card_"},
    "card_type": {"type": "string"},
    "title": {"type": "string"},
    "summary": {"type": "string"},
    "status": {"type": "string"},
    "placement_collection": {"type": ["string", "null"]},
    "shelf": {"type": ["string", "null"]},
    "storage_tier": {"type": ["string", "null"]},
    "visibility_scope": {"enum": ["global", "session", "project", "private"]},
    "session_id": {"type": ["string", "null"]},
    "project_id": {"type": ["string", "null"]},
    "recall_count": {"type": "integer", "minimum": 0},
    "last_recalled_at": {"type": ["string", "null"]},
    "conflict_group": {"type": ["string", "null"]},
    "supersedes_card_id": {"type": ["string", "null"]},
    "superseded_by_card_id": {"type": ["string", "null"]},
    "state_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "source_refs": {"type": "array"},
    "entities": {"type": "array"},
    "topics": {"type": "array"},
    "decisions": {"type": "array"},
    "open_tasks": {"type": "array"},
    "salience": {"type": "number"},
    "confidence": {"type": "number"}
  },
  "additionalProperties": true
}
